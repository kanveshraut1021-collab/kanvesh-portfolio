# Database Configuration (PostgreSQL with SQLAlchemy)
# For local PostgreSQL instance, use format:
# postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql://postgres:postgres@localhost:5432/portfolio_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
