# Frontend Environment Variables (Vite)

# WhatsApp Number in international format WITHOUT '+', spaces, or hyphens
# Example for India (+91 9075919023): 919075919023
VITE_WHATSAPP_NUMBER=919075919023

# Backend API Base URL
# For local development with Vite dev server proxy: leave empty ''
# For production deployment where backend is hosted on a separate URL:
# Example: https://kanvesh-portfolio-backend.vercel.app
VITE_API_BASE_URL=
