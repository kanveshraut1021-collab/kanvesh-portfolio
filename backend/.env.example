# Backend Environment Configuration (FastAPI)

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Obtain from Supabase: Project Settings -> Database -> Connection string (URI)
# Note: In Vercel serverless functions, the Supabase connection pooler (port 6543) is recommended.
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Allowed Frontend Origin for Production CORS (e.g. your deployed Vercel domain)
FRONTEND_URL=https://kanvesh-portfolio.vercel.app

# Server Host & Port (Local Development)
HOST=127.0.0.1
PORT=8000
DEBUG=False
